<%#
  settings/email_form — "Update email" card body. Wrapped in
  #settings_email_form so Settings::EmailsController can replace it via
  Turbo Stream to surface errors in place.
  locals:
    errors: Array<String>  optional; validation messages rendered above the field
%>
<%
  field_classes =
    "w-full rounded-field border border-line bg-card-hi px-3 py-2 " \
      "text-text placeholder:text-text-mute focus:border-brass focus:outline-none"
  errors = local_assigns.fetch(:errors, [])
%>
<div id="settings_email_form">
  <% if errors.any? %>
    <div
      class="mb-4 rounded-field border border-red/40 bg-red/10 px-3 py-2 text-sm font-medium text-red"
    >
      <ul class="list-inside list-disc space-y-1">
        <% errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: settings_email_path, method: :patch do |form| %>
    <div class="mb-4">
      <%= form.label :email_address,
                     t("settings.email.current_email_label"),
                     class:
                       "mb-1.5 block text-xs font-bold uppercase tracking-wide text-text-dim" %>
      <%= form.email_field :email_address,
                           required: true,
                           autocomplete: "username",
                           placeholder: t("auth.email_placeholder"),
                           value: params[:email_address] || Current.user.email_address,
                           class: field_classes %>
    </div>
    <%= form.submit t("settings.email.save"), class: "btn-primary" %>
  <% end %>
</div>
