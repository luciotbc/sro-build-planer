<% content_for :title, t(".title") %>
<div class="mx-auto max-w-lg">
  <header class="mb-6">
    <h1 class="text-2xl font-bold text-text"><%= t(".heading") %></h1>
    <p class="mt-1 text-sm text-text-dim"><%= t(".subtitle") %></p>
  </header>
  <%# Section cards land here one task at a time (docs/todo/023..030). %>
  <div id="settings-sections" class="space-y-6">
    <%= render layout: "shared/settings_card",
          locals: {
            title: t("settings.email.title"),
            description: t("settings.email.description")
          } do %>
      <%= render "settings/email_form" %>
    <% end %>
    <%= render layout: "shared/settings_card",
          locals: {
            title: t("settings.password.title"),
            description: t("settings.password.description")
          } do %>
      <%= render "settings/password_form" %>
    <% end %>
    <%= render layout: "shared/settings_card",
          locals: { title: t("settings.email_opt_in.title") } do %>
      <%= form_with url: settings_email_opt_in_path,
                    method: :patch,
                    data: {
                      controller: "autosubmit"
                    } do |form| %>
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="text-sm font-semibold text-text"><%= t("settings.email_opt_in.label") %></p>
            <p class="mt-0.5 max-w-sm text-[0.8125rem] text-text-dim"><%= t("settings.email_opt_in.hint") %></p>
          </div>
          <%= render "shared/toggle",
                     name: "email_opt_in",
                     checked: Current.user.email_opt_in,
                     sr_label: t("settings.email_opt_in.label"),
                     attrs: {
                       data: {
                         action: "change->autosubmit#submit"
                       }
                     } %>
        </div>
      <% end %>
    <% end %>
    <%= render layout: "shared/settings_card",
          locals: {
            title: t("settings.my_data.title"),
            description: t("settings.my_data.description")
          } do %>
      <%# Terms are accepted at registration, so the accepted date equals
          the account creation date (spec 09 R7 — no terms_accepted_at column). %>
      <div id="settings-my-data">
        <div class="data-row">
          <span class="data-row-label"><%= t("settings.my_data.email") %></span>
          <span class="data-row-value"><%= Current.user.email_address %></span>
        </div>
        <div class="data-row">
          <span class="data-row-label"><%= t("settings.my_data.created") %></span>
          <span class="data-row-value"><%= l(Current.user.created_at.to_date, format: :long) %></span>
        </div>
        <div class="data-row">
          <span class="data-row-label"><%= t("settings.my_data.terms_accepted") %></span>
          <span class="data-row-value"><%= l(Current.user.created_at.to_date, format: :long) %></span>
        </div>
        <div class="data-row">
          <span class="data-row-label"><%= t("settings.my_data.characters") %></span>
          <span class="data-row-value"><%= Current.user.characters.count %></span>
        </div>
      </div>
      <%= form_with url: settings_export_path, method: :post, class: "mt-4" do %>
        <button type="submit" class="btn-ghost">
          ⬇ <%= t("settings.my_data.export") %>
        </button>
      <% end %>
    <% end %>
    <section class="settings-card settings-card--danger" data-controller="dialog">
      <h2 class="settings-card-title text-red"><%= t("settings.delete_account.title") %></h2>
      <p class="settings-card-desc"><%= t("settings.delete_account.description") %></p>
      <div class="settings-card-body">
        <button type="button" class="btn-danger w-full" data-action="dialog#open">
          <%= t("settings.delete_account.trigger") %>
        </button>
      </div>
      <dialog
        id="delete-account-modal"
        class="modal"
        data-dialog-target="dialog"
        data-controller="delete-confirmation"
        data-delete-confirmation-word-value="DELETE"
      >
        <div class="pt-2 text-center">
          <span class="delete-modal-icon" aria-hidden="true">🗑</span>
          <h3 class="mt-3 text-lg font-bold text-text"><%= t("settings.delete_account.modal_title") %></h3>
          <p class="mt-2 text-sm text-text-dim"><%= t("settings.delete_account.modal_body") %></p>
        </div>
        <%= form_with url: settings_account_path, method: :delete, class: "mt-5" do %>
          <label
            for="delete_confirmation"
            class="mb-1.5 block text-left text-xs font-bold uppercase tracking-wide text-text-dim"
          ><%= t("settings.delete_account.confirm_label_html", word: "DELETE") %></label>
          <%= text_field_tag :confirmation,
                             nil,
                             id: "delete_confirmation",
                             autocomplete: "off",
                             placeholder: "delete",
                             class:
                               "w-full rounded-field border border-line bg-card-hi px-3 py-2 " \
                                 "text-text placeholder:text-text-mute focus:border-brass focus:outline-none",
                             data: {
                               delete_confirmation_target: "input",
                               action: "input->delete-confirmation#check"
                             } %>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <button type="button" class="btn-ghost" data-action="dialog#close">
              <%= t("settings.delete_account.cancel") %>
            </button>
            <button
              type="submit"
              class="btn-danger"
              disabled
              data-delete-confirmation-target="submit"
            ><%= t("settings.delete_account.confirm_button") %></button>
          </div>
        <% end %>
      </dialog>
    </section>
  </div>
</div>
