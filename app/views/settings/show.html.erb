<% content_for :title, t(".title") %>
<div class="mx-auto max-w-lg">
  <header class="mb-6">
    <h1 class="text-2xl font-bold text-text"><%= t(".heading") %></h1>
    <p class="mt-1 text-sm text-text-dim"><%= t(".subtitle") %></p>
  </header>
  <%# Section cards land here one task at a time (docs/todo/023..030). %>
  <div id="settings-sections" class="space-y-6">
    <%= render layout: "shared/settings_card",
          locals: {
            title: t("settings.email.title"),
            description: t("settings.email.description")
          } do %>
      <%= render "settings/email_form" %>
    <% end %>
    <%= render layout: "shared/settings_card",
          locals: {
            title: t("settings.password.title"),
            description: t("settings.password.description")
          } do %>
      <%= render "settings/password_form" %>
    <% end %>
    <%= render layout: "shared/settings_card",
          locals: { title: t("settings.email_opt_in.title") } do %>
      <%= form_with url: settings_email_opt_in_path,
                    method: :patch,
                    data: {
                      controller: "autosubmit"
                    } do |form| %>
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="text-sm font-semibold text-text"><%= t("settings.email_opt_in.label") %></p>
            <p class="mt-0.5 max-w-sm text-[0.8125rem] text-text-dim"><%= t("settings.email_opt_in.hint") %></p>
          </div>
          <%= render "shared/toggle",
                     name: "email_opt_in",
                     checked: Current.user.email_opt_in,
                     sr_label: t("settings.email_opt_in.label"),
                     attrs: {
                       data: {
                         action: "change->autosubmit#submit"
                       }
                     } %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
