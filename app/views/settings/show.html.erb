<% content_for :title, t(".title") %>
<div class="mx-auto max-w-lg">
  <header class="mb-6">
    <h1 class="text-2xl font-bold text-text"><%= t(".heading") %></h1>
    <p class="mt-1 text-sm text-text-dim"><%= t(".subtitle") %></p>
  </header>
  <%# Section cards land here one task at a time (docs/todo/023..030). %>
  <div id="settings-sections" class="space-y-6">
    <%= render layout: "shared/settings_card",
          locals: {
            title: t("settings.email.title"),
            description: t("settings.email.description")
          } do %>
      <%= render "settings/email_form" %>
    <% end %>
    <%= render layout: "shared/settings_card",
          locals: {
            title: t("settings.password.title"),
            description: t("settings.password.description")
          } do %>
      <%= render "settings/password_form" %>
    <% end %>
  </div>
</div>
