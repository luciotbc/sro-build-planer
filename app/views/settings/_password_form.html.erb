<%#
  settings/password_form — "Update password" card body. Wrapped in
  #settings_password_form so Settings::PasswordsController can replace it via
  Turbo Stream to surface errors in place.
  locals:
    errors: Array<String>  optional; validation messages rendered above the fields
%>
<%
  label_classes =
    "mb-1.5 block text-xs font-bold uppercase tracking-wide text-text-dim"
  field_classes =
    "w-full rounded-field border border-line bg-card-hi px-3 py-2 " \
      "text-text placeholder:text-text-mute focus:border-brass focus:outline-none"
  errors = local_assigns.fetch(:errors, [])
%>
<div id="settings_password_form">
  <% if errors.any? %>
    <div
      class="mb-4 rounded-field border border-red/40 bg-red/10 px-3 py-2 text-sm font-medium text-red"
    >
      <ul class="list-inside list-disc space-y-1">
        <% errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: settings_password_path,
                method: :patch,
                data: {
                  controller: "password-rules"
                } do |form| %>
    <div class="mb-4">
      <%= form.label :current_password,
                     t("settings.password.current_label"),
                     class: label_classes %>
      <%= form.password_field :current_password,
                              required: true,
                              autocomplete: "current-password",
                              placeholder: t("settings.password.current_placeholder"),
                              maxlength: 72,
                              class: field_classes %>
    </div>
    <%= render "shared/password_fields",
               form: form,
               password_label: t("settings.password.new_label"),
               confirmation_label: t("settings.password.confirmation_label"),
               label_classes: label_classes,
               field_classes: field_classes %>
    <%= form.submit t("settings.password.save"), class: "btn-primary" %>
  <% end %>
</div>
