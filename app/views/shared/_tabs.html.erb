<%#
  shared/tabs — a row of tab buttons in two variants, wired to the `tabs` controller
  -----------------------------------------------------------------------
  The `tabs` Stimulus controller marks one tab active (class `on`) on click.
  locals:
    items:   Array<String>  required; one label per tab
    variant: Symbol         optional; :pill (default, raised chip in a well)
                            or :underline (brass underline subtabs)
    active:  Integer        optional; index of the initially active tab (default 0)
  Usage:
    render "shared/tabs", items: ["Weapon", "Force", "Recovery"]
    render "shared/tabs", items: ["Bicheon", "Heuksal"], variant: :underline, active: 1
%>
<%
  items   = local_assigns.fetch(:items)
  variant = local_assigns.fetch(:variant, :pill)
  active  = local_assigns.fetch(:active, 0)

  wrapper_class, tab_class =
    if variant == :underline
      ["ro-subtabs", "ro-subtab"]
    else
      ["ro-tabs", "ro-tab"]
    end
%>
<div class="<%= wrapper_class %>" data-controller="tabs">
  <% items.each_with_index do |item, index| %>
    <button
      type="button"
      class="<%= class_names(tab_class, "on" => index == active) %>"
      data-tabs-target="tab"
      data-action="tabs#select"
    ><%= item %></button>
  <% end %>
</div>
