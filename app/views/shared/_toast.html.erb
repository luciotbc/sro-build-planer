<%# locals: message, variant (default: "warning") %>
<div
  data-controller="toast"
  data-toast-duration-value="4000"
  class="toast toast--<%= local_assigns.fetch(:variant, "warning") %>"
  role="alert"
  aria-atomic="true"
>
  <p class="toast-message"><%= message %></p>
  <button type="button" class="toast-dismiss"
          data-action="toast#dismiss"
          aria-label="<%= t(".dismiss") %>">×</button>
</div>
