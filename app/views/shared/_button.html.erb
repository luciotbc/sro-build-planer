<%#
  shared/button — primary | ghost | icon | danger
  ----------------------------------------------------------------------------
  locals:
    label:   String — button text (use a glyph string for variant: :icon)
    variant: :primary | :ghost | :icon | :danger   (default :primary)
    href:    String  -> renders an <a>; otherwise a <button>
    type:    String  -> button type (default "button")
    block:   Bool    -> full-width (default false)
    html:    Hash    -> extra attrs merged onto the element (data-*, aria-*)
  ----------------------------------------------------------------------------
  Examples:
    render "shared/button", label: "Edit Planned" 
     render "shared/button", label: "Cancel", variant: :ghost 
     render "shared/button", label: "×", variant: :icon, html: { "aria-label": "Close" }
%>
<% variant = local_assigns.fetch(:variant, :primary)
   html = (local_assigns[:html] || {}).dup
   recipe = {
     primary: "btn-primary",
     ghost: "btn-ghost",
     danger: "btn-danger",
     icon: "inline-flex items-center justify-center w-9 h-9 rounded-field " \
           "bg-card border border-line text-text-dim hover:text-text hover:bg-card-hi cursor-pointer"
   }
   classes = [
     "transition",
     recipe[variant],
     (local_assigns[:block] ? "w-full" : nil),
     html.delete(:class)
   ].compact.join(" ")
   tag_name = local_assigns[:href].present? ? :a : :button
   attrs = { class: classes }
   attrs[:href] = href if tag_name == :a
   attrs[:type] = local_assigns.fetch(:type, "button") if tag_name == :button
   attrs.merge!(html) %>
<%= content_tag tag_name, label, attrs %>
