<%#
  shared/stats_summary — three-row SUMMARY panel (spec 02 R3/R4/R5)
  -----------------------------------------------------------------------
  Shows SKILL POINTS, MASTERY TOTAL, REQUIRED LEVEL in current+delta=planned
  format from Builds::SummaryService data.
  locals:
    summary: Hash  required; result of Builds::SummaryService.call(char).data
             keys: :skill_points, :mastery_total, :required_level
             each: { current:, delta:, planned: }
  Usage:
    render "shared/stats_summary", summary: @summary
%>
<%
  summary    = local_assigns.fetch(:summary)
  extra_class = local_assigns[:class]
%>
<div class="<%= class_names("stat-merged", extra_class) %>">
  <%= render "shared/stat_row",
        label: t(".skill_points"),
        current: summary[:skill_points][:current],
        delta:   summary[:skill_points][:delta],
        planned: summary[:skill_points][:planned] %>
  <%= render "shared/stat_row",
        label: t(".mastery_total"),
        current: summary[:mastery_total][:current],
        delta:   summary[:mastery_total][:delta],
        planned: summary[:mastery_total][:planned] %>
  <%= render "shared/stat_row",
        label: t(".required_level"),
        current: summary[:required_level][:current],
        delta:   summary[:required_level][:delta],
        planned: summary[:required_level][:planned] %>
</div>
