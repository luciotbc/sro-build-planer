<%# Live "Password must have" checklist panel (design system: .password-rules).
    Requires an enclosing data-controller="password-rules" scope with password
    (and optionally confirmation) targets; hidden until the user edits one.
    The "match" item is skipped by the controller when no confirmation
    target exists. %>
<div class="password-rules mb-4" hidden data-password-rules-target="panel">
  <p class="password-rules-heading"><%= t("shared.password_fields.rules_heading") %></p>
  <ul class="password-rules-list">
    <li data-rule="length" data-password-rules-target="rule"><%= t("shared.password_fields.rule_length") %></li>
    <li data-rule="uppercase" data-password-rules-target="rule"><%= t("shared.password_fields.rule_uppercase") %></li>
    <li data-rule="number" data-password-rules-target="rule"><%= t("shared.password_fields.rule_number") %></li>
    <li data-rule="match" data-password-rules-target="rule"><%= t("shared.password_fields.rule_match") %></li>
  </ul>
</div>
