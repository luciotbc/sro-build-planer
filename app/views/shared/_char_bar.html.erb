<%#
  shared/char_bar — character identity bar: crest avatar, name, race, level cap
  -----------------------------------------------------------------------
  locals:
    name:    String          required; character name (rendered in brass)
    race:    String          required; race label (e.g. "Chinese"); also picks
                             the crest icon (china.png / europe.png)
    level:   Integer/String  required; level cap value
    class:   String          optional; extra utility classes (e.g. responsive
                             width overrides). Appended to the .char-bar element.
  Usage:
    render "shared/char_bar", name: "BuckTBC", race: "Chinese", level: 110
%>
<%
  name  = local_assigns.fetch(:name)
  race  = local_assigns.fetch(:race)
  level = local_assigns.fetch(:level)
  extra = local_assigns[:class]
%>
<div class="<%= class_names("char-bar", extra) %>">
  <div class="char-bar-id">
    <div class="char-avatar"><%= race_icon_tag(race) %></div>
    <div>
      <div class="char-bar-name"><%= name %></div>
      <div class="char-bar-race"><%= race %></div>
    </div>
  </div>
  <div class="char-bar-level">
    <span class="char-bar-level-label whitespace-nowrap"><%= t(".level_cap") %></span>
    <span class="char-bar-level-val"><%= level %></span>
  </div>
</div>
