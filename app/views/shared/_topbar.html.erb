<%#
  shared/topbar — sticky frosted top bar with brand mark + actions slot
  -----------------------------------------------------------------------
  locals:
    actions: String  rendered HTML for the right side (buttons / chars-pill)
  Usage:
    render "shared/topbar"
    render "shared/topbar", actions: capture { ... }
%>
<header class="sticky top-0 z-10 border-b border-line bg-bg/85 backdrop-blur-md backdrop-saturate-150">
  <div class="mx-auto max-w-7xl flex items-center justify-between gap-3 px-4 py-3 md:px-8 md:py-3.5">
    <%= link_to root_path, class: "flex items-center gap-2.5 font-bold text-base tracking-[0.2px] text-text hover:opacity-90 transition-opacity" do %>
      <%= image_tag "icon.svg", alt: "", class: "h-7 w-7", aria: { hidden: true } %>
      <span><%= t("app.name") %></span>
    <% end %>
    <div class="flex items-center gap-2"><%= local_assigns[:actions] %></div>
  </div>
</header>
