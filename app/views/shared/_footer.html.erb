<%#
  shared/footer — site-wide footer shown on every page
  -----------------------------------------------------------------------
  Mockup-aligned grid: row 1 is brand · disclaimer · author credit; row 2 is
  the language switcher (spanning the left two columns so it stays on one line)
  and the legal links (right). Each locale is a PATCH button to /settings/locale
  (works signed-out; persists to the user record once signed in — spec 08 R12).
  The active locale renders as a non-interactive brass marker; the rest are
  switch buttons. Native language names come from LocaleOption (display data,
  never translated — spec 08).
%>
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <%= link_to root_path, class: "site-footer-logo" do %>
        <%= image_tag "icon.svg", alt: "", class: "site-footer-logo-mark", aria: { hidden: true } %>
        <span><%= t("shared.footer.product_name") %></span>
      <% end %>
    </div>

    <%# A div, not a <p>: button_to renders a <form>, which the HTML parser
        would hoist out of a <p>, breaking the inline language row. %>
    <div class="site-footer-locales">
      <span class="site-footer-available"><%= t("shared.footer.available_in") %></span>
      <% LocaleOption.all.each do |option| %>
        <% if option.code == I18n.locale.to_s %>
          <span
            class="site-footer-locale-item site-footer-locale is-active"
            aria-current="true"
          ><%= option.native_name %></span>
        <% else %>
          <%= button_to option.native_name,
                settings_locale_path,
                method: :patch,
                params: {
                  locale: option.code
                },
                class: "site-footer-locale",
                form_class: "site-footer-locale-item" %>
        <% end %>
      <% end %>
    </div>

    <p class="site-footer-disclaimer"><%= t("shared.footer.disclaimer") %></p>

    <p class="site-footer-credit">
      <%= t(
            "shared.footer.developed_by_html",
            author:
              link_to(
                "@luciotbc",
                "https://lucio.app/",
                class: "site-footer-link",
                target: "_blank",
                rel: "noopener"
              )
          ) %>
    </p>

    <nav class="site-footer-nav" aria-label="<%= t("shared.footer.legal") %>">
      <%= link_to t("pages.privacy.title"), privacy_path, class: "site-footer-navlink" %>
      <%= link_to t("pages.terms.title"), terms_path, class: "site-footer-navlink" %>
    </nav>
  </div>
</footer>
