<%#
  shared/sheet — bottom-rising native <dialog> panel driven by the `dialog` controller
  -----------------------------------------------------------------------
  A trigger button opens the dialog; Esc, backdrop click and the × button
  close it. Rises from the bottom of the viewport.
  locals:
    title:         String  optional; dialog heading (default "Dialog")
    trigger_label: String  optional; text on the open button (default "Open")
  Usage:
    render "shared/sheet", title: "Cyclone III", trigger_label: "Details"
%>
<%
  title         = local_assigns.fetch(:title, "Dialog")
  trigger_label = local_assigns.fetch(:trigger_label, "Open")
%>
<div data-controller="dialog">
  <button type="button" class="btn-ghost" data-action="dialog#open"><%= trigger_label %></button>
  <dialog
    class="sheet"
    data-dialog-target="dialog"
    data-action="click->dialog#backdropClose"
  >
    <header class="overlay-head">
      <span><%= title %></span>
      <button type="button" class="icon-btn" data-action="dialog#close" aria-label="Close">×</button>
    </header>
    <div class="pt-4 text-sm leading-relaxed text-text-dim">
      <p>This is a sample sheet body. Quick actions and details go here.</p>
      <p class="mt-2">It rises from the bottom and dismisses on backdrop click.</p>
    </div>
  </dialog>
</div>
