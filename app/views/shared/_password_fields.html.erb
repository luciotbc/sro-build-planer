<%#
  shared/password_fields — new + confirmation password inputs with the live
  "Password must have" rules checklist (design system: .password-rules).
  Wrap the surrounding form (or a container) with
  data-controller="password-rules"; this partial provides the targets.
  locals:
    form:                the form builder (required)
    password_label:      label for the new password field (required)
    confirmation_label:  label for the confirmation field (required)
    label_classes:       optional CSS classes for both labels
    field_classes:       optional CSS classes for both inputs
%>
<%
  label_classes =
    local_assigns.fetch(
      :label_classes,
      "mb-1.5 block text-xs font-bold uppercase tracking-wide text-text-dim"
    )
  field_classes =
    local_assigns.fetch(
      :field_classes,
      "w-full rounded-field border border-line bg-card-hi px-3 py-2 " \
        "text-text placeholder:text-text-mute focus:border-brass focus:outline-none"
    )
%>
<div class="mb-4 grid gap-4 sm:grid-cols-2">
  <div>
    <%= form.label :password, password_label, class: label_classes %>
    <%= form.password_field :password,
                            required: true,
                            autocomplete: "new-password",
                            placeholder: t("shared.password_fields.new_placeholder"),
                            maxlength: 72,
                            class: field_classes,
                            data: {
                              password_rules_target: "password",
                              action: "input->password-rules#check"
                            } %>
  </div>
  <div>
    <%= form.label :password_confirmation, confirmation_label, class: label_classes %>
    <%= form.password_field :password_confirmation,
                            required: true,
                            autocomplete: "new-password",
                            placeholder: t("shared.password_fields.confirm_placeholder"),
                            maxlength: 72,
                            class: field_classes,
                            data: {
                              password_rules_target: "confirmation",
                              action: "input->password-rules#check"
                            } %>
  </div>
</div>
<%= render "shared/password_rules" %>
