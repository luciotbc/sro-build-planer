<% content_for :title, @character.name %>
<% content_for :head do %>
  <%= tag.meta property: "og:type", content: "website" %>
  <%= tag.meta property: "og:title", content: @character.name %>
  <%= tag.meta property: "og:url", content: shared_build_url(@character.share_token) %>
  <%= tag.meta property: "og:image", content: image_url(race_icon_file(@character.race.name)) %>
  <%= tag.meta property: "og:description", content: og_build_description(@character) %>
<% end %>

<%# Public, read-only shared build page (task 021, spec 05). No edit
    affordances: navigation stays on the shared route, no forms. %>
<div class="mx-auto w-full max-w-[520px] md:max-w-3xl space-y-4 md:space-y-5">
  <%# ── Box: character identity (no share icon — link box above) ─────────── %>
  <%= render "shared/char_bar",
        name:  @character.name,
        race:  @character.race.name,
        level: @character.server_level_cap,
        class: "md:max-w-none" %>

  <%# ── Box: summary (spec 02 R3/R4/R5) ─────────────────────────────────── %>
  <section class="rounded-panel border border-line bg-card p-4 space-y-4">
    <h2 class="text-xs font-bold uppercase tracking-[2px] text-text-dim"><%= t(".summary") %></h2>
    <%= render "shared/stats_summary", summary: @summary, class: "max-w-none" %>
  </section>

  <%# ── Box: skills (same panel as the planner, read-only) ───────────────── %>
  <%= render "characters/skills_panel",
        character:             @character,
        grouped_masteries:     @grouped_masteries,
        mastery_types:         @mastery_types,
        active_mastery:        @active_mastery,
        current_mastery_level: @current_mastery_level,
        target_mastery_level:  @target_mastery_level,
        series_groups:         @series_groups,
        tab_url:               ->(m) { shared_build_path(@character.share_token, mastery_id: m.id) } %>

  <%# ── Box: share link ──────────────────────────────────────────────────── %>
  <section class="rounded-panel border border-line bg-card p-4 space-y-2">
    <h2 class="text-xs font-bold uppercase tracking-[2px] text-text-dim"><%= t(".share_link") %></h2>
    <div
      class="flex items-center gap-2"
      data-controller="clipboard"
      data-clipboard-text-value="<%= shared_build_url(@character.share_token) %>"
    >
      <input
        type="text"
        readonly
        autocomplete="off"
        value="<%= shared_build_url(@character.share_token) %>"
        class="w-full min-w-0 rounded-control border border-line bg-card-hi px-3 py-2 text-sm text-text-dim"
        data-action="focus->clipboard#copy"
        aria-label="<%= t(".share_link") %>"
      >
      <button
        type="button"
        class="icon-btn shrink-0"
        data-action="clipboard#copy"
        aria-label="<%= t(".copy") %>"
        title="<%= t(".copy") %>"
      >
        <span data-clipboard-target="icon" aria-hidden="true">⧉</span>
        <span data-clipboard-target="check" class="hidden text-brass" aria-hidden="true">✓</span>
      </button>
    </div>
  </section>
</div>
