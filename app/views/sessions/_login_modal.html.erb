<%#
  sessions/login_modal — topbar "Log in" trigger + centered <dialog> hosting the
  sign-in form. Driven by the `dialog` Stimulus controller (Esc / backdrop / ×
  close). The dialog is position:fixed, so it overlays the page regardless of
  where it sits in the markup.
%>
<div data-controller="dialog">
  <button type="button" class="btn-primary" data-action="dialog#open">Log in</button>
  <dialog
    class="modal"
    data-dialog-target="dialog"
    data-action="click->dialog#backdropClose"
  >
    <header class="dialog-head">
      <span>Sign in</span>
      <button
        type="button"
        class="icon-btn"
        data-action="dialog#close"
        aria-label="Close"
      >×</button>
    </header>
    <div class="dialog-body">
      <%= render "sessions/form" %>
    </div>
  </dialog>
</div>
