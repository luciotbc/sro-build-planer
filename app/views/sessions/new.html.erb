<div class="-mx-4 -mt-4 flex min-h-[calc(100vh-5rem)] items-center justify-center p-4 md:-mx-8 md:-mt-5">
  <div class="w-full max-w-[400px] rounded-panel border border-line bg-card p-6">
    <h1 class="mb-6 text-2xl font-extrabold tracking-[-0.3px]">
      <span class="text-brass-hi">SRO</span> Builder
    </h1>

    <% if alert = flash[:alert] %>
      <div class="mb-4 rounded-field border border-red/40 bg-red/10 px-3 py-2 text-[13px] text-red" id="alert"><%= alert %></div>
    <% end %>

    <% if notice = flash[:notice] %>
      <div class="mb-4 rounded-field border border-green/40 bg-green/10 px-3 py-2 text-[13px] text-green" id="notice"><%= notice %></div>
    <% end %>

    <%= form_with url: session_url do |form| %>
      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <%= form.label :email_address, "Email",
              class: "text-[11px] font-bold uppercase tracking-[0.8px] text-text-dim" %>
          <%= form.email_field :email_address,
              required: true,
              autofocus: true,
              autocomplete: "username",
              value: params[:email_address],
              class: "w-full rounded-field bg-card-hi border border-line px-3 py-2.5 text-sm text-text focus:border-brass focus:outline-none" %>
        </div>

        <div class="flex flex-col gap-2">
          <%= form.label :password, "Password",
              class: "text-[11px] font-bold uppercase tracking-[0.8px] text-text-dim" %>
          <%= form.password_field :password,
              required: true,
              autocomplete: "current-password",
              maxlength: 72,
              class: "w-full rounded-field bg-card-hi border border-line px-3 py-2.5 text-sm text-text focus:border-brass focus:outline-none" %>
        </div>
      </div>

      <%= form.submit "Sign in",
          class: "btn-primary w-full min-h-[52px] text-[15px] rounded-control mt-6" %>
    <% end %>

    <div class="mt-4 text-center">
      <%= link_to "Forgot password?", new_password_path,
          class: "text-sm text-text-dim underline hover:no-underline" %>
    </div>
  </div>
</div>
