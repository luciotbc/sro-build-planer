<%#
  sessions/auth_modals — topbar "Log in" / "Create account" triggers plus the
  sign-in, sign-up and "check your email" dialogs. All descendants of the
  page-level `auth` Stimulus controller (declared on <body>) so any button on
  the page — including the landing-page hero and bottom CTA — can open these
  dialogs via data-action="auth#showSignup" / "auth#showLogin".
%>
<% registered_email = flash[:registered_email] %>
<div>
  <button type="button" class="btn-ghost" data-action="auth#showLogin"><%= t(".log_in") %></button>
  <button type="button" class="btn-primary" data-action="auth#showSignup"><%= t(".create_account") %></button>

  <%# ---- Sign in ---- %>
  <dialog
    class="modal"
    aria-labelledby="login_modal_title"
    data-auth-target="login"
    data-action="click->auth#backdropClose"
  >
    <header class="overlay-head">
      <span id="login_modal_title"><%= t(".sign_in_title") %></span>
      <button type="button" class="icon-btn" data-action="auth#close" aria-label="<%= t(".close") %>">×</button>
    </header>
    <div class="overlay-body">
      <%= render "sessions/form" %>
      <p class="mt-5 text-sm text-text-dim">
        <%= t(".new_here") %>
        <button type="button" class="text-brass underline hover:text-brass-hi" data-action="auth#showSignup">
          <%= t(".create_an_account") %>
        </button>
      </p>
    </div>
  </dialog>

  <%# ---- Sign up ---- %>
  <dialog
    class="modal"
    aria-labelledby="signup_modal_title"
    data-auth-target="signup"
    data-action="click->auth#backdropClose"
  >
    <header class="overlay-head">
      <span id="signup_modal_title"><%= t(".signup_title") %></span>
      <button type="button" class="icon-btn" data-action="auth#close" aria-label="<%= t(".close") %>">×</button>
    </header>
    <div class="overlay-body">
      <%= render "registrations/form" %>
      <p class="mt-5 text-sm text-text-dim">
        <%= t(".already_have_account") %>
        <button type="button" class="text-brass underline hover:text-brass-hi" data-action="auth#showLogin">
          <%= t(".sign_in") %>
        </button>
      </p>
    </div>
  </dialog>

  <%# ---- Check your email (auto-opens after a successful sign-up) ---- %>
  <% if registered_email %>
    <dialog
      class="modal"
      aria-labelledby="confirm_modal_title"
      data-auth-target="confirm"
      data-action="click->auth#backdropClose"
    >
      <header class="overlay-head">
        <span id="confirm_modal_title"><%= t(".confirm_title") %></span>
        <button type="button" class="icon-btn" data-action="auth#close" aria-label="<%= t(".close") %>">×</button>
      </header>
      <div class="overlay-body">
        <p class="text-sm leading-relaxed text-text-dim">
          <%= t(
            ".confirmation_sent_html",
            email: tag.span(registered_email, class: "font-semibold text-text")
          ) %>
        </p>
        <div class="mt-5 flex items-center justify-between gap-4">
          <button type="button" class="btn-primary" data-action="auth#showLogin"><%= t(".got_it") %></button>
          <%= button_to t(".resend"),
                        resend_email_confirmation_path,
                        params: {
                          email_address: registered_email
                        },
                        class:
                          "text-sm text-text-dim underline hover:text-text bg-transparent border-0 cursor-pointer p-0" %>
        </div>
      </div>
    </dialog>
  <% end %>
</div>
