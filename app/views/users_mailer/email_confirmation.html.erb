<h1 style="font-family: sans-serif; font-size: 20px; color: #15181f;"><%= t(".heading") %></h1>

<p style="font-family: sans-serif; font-size: 14px; color: #15181f;">
  <%= t(".welcome") %>
</p>

<p style="margin: 24px 0;">
  <%= link_to t(".button"),
              @confirmation_url,
              style:
                "display: inline-block; padding: 10px 18px; border-radius: 10px; " \
                  "background: #d4a847; color: #0c0e12; font-family: sans-serif; " \
                  "font-size: 13px; font-weight: 800; text-decoration: none;" %>
</p>

<p style="font-family: sans-serif; font-size: 12px; color: #5c6270;">
  <%= t(".fallback") %><br>
  <%= @confirmation_url %>
</p>

<p style="font-family: sans-serif; font-size: 12px; color: #5c6270;">
  <%= t(".expiry") %>
</p>
