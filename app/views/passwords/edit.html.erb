<% content_for :title, t(".heading") %>
<div class="mx-auto max-w-md">
  <% if alert = flash[:alert] %>
    <p
      class="mb-5 inline-block rounded-field border border-red/40 bg-red/10 px-3 py-2 text-sm font-medium text-red"
      id="alert"
    ><%= alert %></p>
  <% end %>

  <h1 class="mb-6 text-xl font-bold text-text"><%= t(".heading") %></h1>

  <%= form_with url: password_path(params[:token]),
                method: :put,
                data: {
                  controller: "password-rules"
                } do |form| %>
    <%= render "shared/password_fields",
               form: form,
               password_label: t("settings.password.new_label"),
               confirmation_label: t("settings.password.confirmation_label") %>
    <%= form.submit t(".submit"), class: "btn-primary" %>
  <% end %>
</div>
