<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SRO Lab" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% content_for :topbar_actions do %>
      <% if authenticated? %>
        <%= render "shared/chars_drawer",
              characters: Current.user.characters.order(:name) %>
        <%= button_to "Log out", session_path, method: :delete, class: "btn-ghost" %>
      <% else %>
        <%= render "sessions/auth_modals" %>
      <% end %>
    <% end %>
    <%= render "shared/topbar", actions: content_for(:topbar_actions) %>
    <main class="mx-auto max-w-7xl px-4 py-8 md:px-8">
      <%= yield %>
    </main>
  </body>
</html>
