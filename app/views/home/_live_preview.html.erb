<%#
  home/live_preview — static screenshot of a real build (task 018).
  Deliberately not a live partial render: the demo must stay pixel-cheap and
  independent of any signed-in character's data, so it ships as a pre-rendered
  image (app/assets/images/landing/demo_build.png) instead of reusing
  shared/char_bar + shared/skill_row at request time.
%>
<section id="live-preview" class="py-14 md:py-20">
  <div class="mx-auto mb-8 max-w-2xl text-center">
    <%= render "shared/badge", text: t(".badge"), variant: :planned %>
    <h2 class="mt-4 text-2xl font-extrabold text-text md:text-3xl"><%= t(".title") %></h2>
    <p class="mt-3 text-text-dim">
      <%= t(".subtitle") %>
    </p>
  </div>
  <div class="mx-auto max-w-[640px] rounded-panel border border-line bg-card p-2 md:p-3">
    <%= image_tag "landing/demo_build.png",
          alt: t(".image_alt"),
          class: "w-full h-auto rounded-tab" %>
  </div>
</section>
