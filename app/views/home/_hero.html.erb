<%# home/hero — landing page pitch + primary signup CTA (task 018) %>
<section class="pt-14 pb-10 md:pt-20 md:pb-14 text-center">
  <p class="mb-4 flex items-center justify-center gap-3 text-xs font-bold uppercase tracking-[3px] text-brass">
    <span class="h-px w-8 bg-brass/40" aria-hidden="true"></span>
    <%= t(".kicker") %>
    <span class="h-px w-8 bg-brass/40" aria-hidden="true"></span>
  </p>
  <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-text md:text-6xl">
    <%= t(".title_line1") %><br>
    <span class="text-brass-hi"><%= t(".title_line2") %></span>
  </h1>
  <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-text-dim md:text-lg">
    <%= t(".subtitle") %>
  </p>
  <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
    <button type="button" class="btn-primary" data-action="auth#showSignup"><%= t(".cta") %></button>
    <a href="#live-preview" class="btn-ghost"><%= t(".see_it_in_action") %></a>
  </div>
</section>
