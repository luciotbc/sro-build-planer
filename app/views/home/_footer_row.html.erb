<%#
  home/footer_row — compact "current +delta = planned" line for the window foot
  locals: label:, current:, planned:, format: (:int | :comma)
%>
<% fmt = ->(n) { local_assigns[:format] == :comma ? number_with_delimiter(n) : n }
   delta = planned - current %>
<div class="flex items-baseline justify-between gap-2.5">
  <span class="text-[11px] font-bold uppercase tracking-[0.6px] text-text-dim"><%= label %></span>
  <span class="inline-flex items-baseline gap-1.5 whitespace-nowrap text-[13px] font-extrabold tnum">
    <span class="text-white"><%= fmt.(current) %></span>
    <% if delta != 0 %>
      <span class="mx-0.5 text-[11px] font-bold <%= delta.positive? ? "text-green" : "text-red" %>"><%= "#{delta.positive? ? "+" : "−"}#{fmt.(delta.abs)}" %></span>
    <% end %>
    <span class="font-semibold text-text-mute">=</span>
    <span class="text-brass-hi"><%= fmt.(planned) %></span>
  </span>
</div>
