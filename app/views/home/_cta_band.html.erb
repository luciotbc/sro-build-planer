<%# home/cta_band — repeats the signup CTA below the fold (task 018) %>
<section class="border-t border-line py-14 text-center md:py-20">
  <h2 class="text-2xl font-extrabold text-text md:text-3xl">
    <%= t(".title_html", highlight: tag.span(t(".highlight"), class: "text-brass-hi")) %>
  </h2>
  <p class="mt-3 text-text-dim"><%= t(".subtitle") %></p>
  <div class="mt-6">
    <button type="button" class="btn-primary" data-action="auth#showSignup"><%= t(".cta") %></button>
  </div>
</section>
