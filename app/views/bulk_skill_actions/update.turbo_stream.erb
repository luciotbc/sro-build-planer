<%= render "shared/editor_mastery_refresh",
      character: @character,
      active_mastery: @mastery,
      mastery_level: @mastery_level,
      side: @side,
      series_groups: @series_groups %>
<% @warnings.each do |warning| %>
  <%= turbo_stream.append "toast-container" do %>
    <%= render "shared/toast", message: warning %>
  <% end %>
<% end %>
