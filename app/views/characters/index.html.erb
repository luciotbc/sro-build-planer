<h1>My Characters</h1>

<% if @characters.empty? %>
  <p>No characters yet.</p>
<% else %>
  <ul>
    <% @characters.each do |character| %>
      <li data-character-id="<%= character.id %>">
        <%= link_to character.name, character_path(character) %>
      </li>
    <% end %>
  </ul>
<% end %>

<%= link_to "New Character", new_character_path %>
