<%
  skills_heading     = @side == :current ? t(".current_skills") : t(".future_skills")
  side_badge_text    = @side == :current ? t(".active_badge") : t(".planning_badge")
  side_badge_variant = @side == :current ? :current : :planned
%>

<%# Mobile-first single column capped at the char-bar width (520px); on desktop
    the column widens to the 768px mockup width and centers in the page so every
    box shares one alignment edge (spec 07 / design-system parity). %>
<div class="mx-auto w-full max-w-[520px] md:max-w-3xl space-y-4 md:space-y-5">
  <%# ── Back to the planner (navigation affordance) ───────────────────────── %>
  <%= link_to t(".back"), character_path(@character, mastery_id: @active_mastery&.id),
        class: "btn-ghost text-xs" %>

  <%# ── Box: character identity ──────────────────────────────────────────── %>
  <%= render "shared/char_bar",
        name: @character.name,
        race: @character.race.name,
        level: @character.server_level_cap,
        initial: @character.race.name == "Chinese" ? "华" : "⚔",
        class: "md:max-w-none" %>

  <%# ── Box: skills (outer panel) ────────────────────────────────────────── %>
  <section class="rounded-panel border border-line bg-card p-4 space-y-4">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-xs font-bold uppercase tracking-[2px] text-text-dim">
        <%= skills_heading %>
      </h2>
      <%= render "shared/badge", text: side_badge_text, variant: side_badge_variant %>
    </div>

    <%# Turbo Stream error target — replaced on failure by skill/mastery controllers %>
    <div id="skill-editor-error"></div>

    <%# Defensive empty state: the editor lists all masteries of the race
        (spec 07), so this only renders for a race with no masteries at all. %>
    <% if @active_mastery.nil? %>
      <p class="text-sm text-text-dim"><%= t(".no_mastery_for_race") %></p>
    <% else %>
      <%# ── Mastery navigation: type pills + per-group sub-tabs (spec 07) ──── %>
      <% if @grouped_masteries.any? %>
        <div class="space-y-3" data-controller="mastery-tabs">
          <%# Row 1 — mastery type pills (Weapon / Force / …) %>
          <div class="ro-tabs max-w-none">
            <% @mastery_types.each do |type| %>
              <button
                type="button"
                class="<%= class_names("ro-tab", "on" => type == @active_mastery.mastery_type) %>"
                data-mastery-tabs-target="typeTab"
                data-action="mastery-tabs#selectType"
                data-mastery-type="<%= type %>"
              ><%= type %></button>
            <% end %>
          </div>

          <%# Row 2 — specific mastery sub-tabs (Blade / Spear / …) %>
          <% @mastery_types.each do |type| %>
            <div
              class="ro-subtabs max-w-none <%= "hidden" unless type == @active_mastery.mastery_type %>"
              data-mastery-tabs-target="panel"
              data-mastery-type="<%= type %>"
            >
              <% (@grouped_masteries[type] || []).each do |mastery| %>
                <%= link_to mastery.name,
                      edit_character_path(@character, side: @side, mastery_id: mastery.id),
                      class: class_names("ro-subtab", "on" => @active_mastery.id == mastery.id),
                      "data-turbo-frame": "skill-window",
                      "data-mastery-id": mastery.id,
                      "data-mastery-tabs-target": "masteryTab",
                      "data-action": "mastery-tabs#selectMastery" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%
        skills_allocated = @series_groups.sum { |g| g[:skills].sum { |e| e[:level] } }
        skills_total     = @series_groups.sum { |g| g[:skills].sum { |e| e[:cap] } }
      %>
      <turbo-frame id="skill-window" class="block space-y-4">
        <%= render "shared/mastery_header",
              character: @character,
              mastery: @active_mastery,
              mastery_level: @mastery_level,
              side: @side,
              skills_allocated: skills_allocated,
              skills_total: skills_total %>
        <% if @series_groups.empty? %>
          <p class="text-sm text-text-dim"><%= t(".no_series") %></p>
        <% else %>
        <%# Bulk actions (spec 06 R4/R5/R6). Undo (R7) is task 012 / not built;
            the hold-to-max hint is omitted until that interaction exists. %>
        <%#
          Bulk actions: full-width 3-up grid on mobile; on desktop the buttons
          shrink to fit their label and left-align in a row, per the mockup.
        %>
        <%
          action_btn =
            "w-full md:w-auto rounded-field border border-line bg-card px-3 md:px-5 py-4 " \
              "text-sm font-bold text-text hover:bg-card-hi transition-colors"
        %>
        <div class="grid grid-cols-3 gap-2 md:flex md:flex-wrap">
          <%= form_with url: max_mastery_character_path(@character), data: { turbo: true }, html: { class: "contents" } do |f| %>
            <%= f.hidden_field :side, value: @side %>
            <%= f.hidden_field :mastery_id, value: @active_mastery.id %>
            <%= f.button t(".max_mastery"), type: :submit, class: action_btn %>
          <% end %>
          <%= form_with url: max_skills_character_path(@character), data: { turbo: true }, html: { class: "contents" } do |f| %>
            <%= f.hidden_field :side, value: @side %>
            <%= f.hidden_field :mastery_id, value: @active_mastery.id %>
            <%= f.button t(".max_skills"), type: :submit, class: action_btn %>
          <% end %>
          <%= form_with url: clear_mastery_character_path(@character), data: { turbo: true }, html: { class: "contents" } do |f| %>
            <%= f.hidden_field :side, value: @side %>
            <%= f.hidden_field :mastery_id, value: @active_mastery.id %>
            <%= f.button t(".clear_all"), type: :submit, class: "#{action_btn} !text-red" %>
          <% end %>
        </div>
        <div class="flex flex-col gap-3">
          <% @series_groups.each do |group| %>
            <%
              allocated = group[:skills].count { |e| e[:level] > 0 }
              total     = group[:skills].size
            %>
            <div class="rounded-panel border border-line bg-card-hi overflow-hidden"
                 data-controller="collapsible">
              <button type="button"
                      class="w-full flex items-center justify-between gap-3 px-4 py-3"
                      data-action="collapsible#toggle"
                      aria-label="<%= t(".toggle_series", title: group[:series].title) %>">
                <span class="flex min-w-0 items-center gap-3">
                  <span class="series-badge" aria-hidden="true">
                    <%= game_icon_tag(group[:series].icon_path, alt: "") || "✦" %>
                  </span>
                  <span class="truncate text-sm font-bold text-text">
                    <%= group[:series].title %>
                  </span>
                  <span class="tnum text-xs font-semibold text-text-mute">
                    <%= allocated %>/<%= total %>
                  </span>
                </span>
                <span class="icon-btn shrink-0" data-collapsible-target="chevron"
                      aria-hidden="true">▾</span>
              </button>
              <div class="border-t border-line" data-collapsible-target="body">
                <% group[:skills].each do |entry| %>
                  <%= render "shared/editor_skill_row",
                        character: @character,
                        skill_group: entry[:skill_group],
                        level: entry[:level],
                        cap: entry[:cap],
                        side: @side %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <% end %>
      </turbo-frame>
    <% end %>
  </section>
</div>
