<%= form_with model: character do |f| %>
  <% if character.errors.any? %>
    <ul>
      <% character.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :race_id, "Race" %>
    <%= f.collection_select :race_id, Race.all, :id, :name, prompt: "Select race" %>
  </div>

  <div>
    <%= f.label :server_level_cap, "Server level cap" %>
    <%= f.select :server_level_cap, Character::SERVER_LEVEL_CAPS.zip(Character::SERVER_LEVEL_CAPS) %>
  </div>

  <%= f.submit %>
<% end %>
