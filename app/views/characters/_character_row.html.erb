<%#
  characters/character_row — one row inside the characters drawer
  locals: character:, active: Bool
%>
<%= button_to select_character_path(character),
class:
  "flex w-full items-center gap-3 rounded-control px-3 py-2.5 text-left " \
    "cursor-pointer hover:bg-card #{"bg-card" if active}",
form: {
  data: {
    turbo_frame: "_top"
  }
} do %>
  <span class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-control border border-line">
    <%= race_glyph(character.race, size: 24) %>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-bold"><%= character.name %></span>
    <span class="flex items-center gap-1.5 text-[11px] text-text-dim">
      <%= character.race.name %> • Lv <%= character.target_level %> •
      <%= character.character_skills.size %> skills
    </span>
  </span>
  <% if active %>
    <%= render "shared/badge", label: "active", tone: :lock, html: { class: "text-brass-hi" } %>
  <% end %>
<% end %>
