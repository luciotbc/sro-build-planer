<%#
  shared/skill_row — skill icon + name + level, with − / + stepper
  Driven by the `stepper` Stimulus controller. Each row is self-contained so it
  can be swapped by a Turbo Stream after a server-side level change.
  --------------------------------------------------------------------------
  locals:
    skill:  an object/hash responding to id, name, level, max
  --------------------------------------------------------------------------
  Wrap rows inside a series card:
    <div class="overflow-hidden rounded-tab bg-card-hi">
      <%= render partial: "shared/skill_row", collection: @skills, as: :skill %>
    </div>
%>
<% maxed = skill[:level] >= skill[:max] %>
<div id="skill_<%= skill[:id] %>"
     class="flex min-h-16 items-center gap-3 border-t border-line px-3.5 py-2.5 first:border-t-0"
     data-controller="stepper"
     data-stepper-level-value="<%= skill[:level] %>"
     data-stepper-max-value="<%= skill[:max] %>"
     data-stepper-url-value="<%= skill_path(skill[:id]) %>">

  <button type="button"
          class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-control cursor-pointer
                 bg-gradient-to-b from-[#0a0a0b] to-[#161618]
                 shadow-[0_0_0_1px_#6b5a30_inset,0_0_0_2px_#000_inset]
                 hover:shadow-[0_0_0_1px_var(--color-brass-hi)_inset,0_0_0_2px_#000_inset]"
          data-action="stepper#info">
    <%= image_tag skill[:icon], class: "h-9 w-9 rounded-md", alt: "" if skill[:icon] %>
  </button>

  <div class="flex min-w-0 flex-1 flex-col gap-[3px]">
    <span class="text-sm font-semibold text-text"><%= skill[:name] %></span>
    <span class="flex items-center gap-1.5 text-[13px]">
      <span class="text-[15px] font-extrabold text-brass-hi tnum" data-stepper-target="level"><%= skill[:level] %></span>
      <% if maxed %><span class="ml-1.5 rounded px-1.5 py-px text-[10px] font-extrabold tracking-[0.4px] bg-brass text-bg">MAX</span><% end %>
    </span>
  </div>

  <div class="flex shrink-0 items-center gap-2">
    <button type="button" data-action="stepper#dec" data-stepper-target="dec"
            class="flex h-11 w-11 items-center justify-center rounded-control cursor-pointer select-none
                   bg-card-hi border border-line text-text text-xl font-extrabold
                   hover:bg-card hover:border-[#3a3f4b] active:scale-95">−</button>
    <button type="button" data-action="stepper#inc" data-stepper-target="inc"
            class="flex h-11 w-11 items-center justify-center rounded-control cursor-pointer select-none
                   border-0 text-bg text-xl font-extrabold bg-gradient-to-b from-brass-hi to-brass
                   active:scale-95">+</button>
  </div>
</div>
