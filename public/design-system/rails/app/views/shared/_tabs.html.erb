<%#
  shared/tabs — pill tabs (mastery types) + underline subtabs (masteries)
  Driven by the `tabs` Stimulus controller (app/javascript/controllers/tabs_controller.js)
  --------------------------------------------------------------------------
  locals:
    tabs:     Array of { id:, label: }
    variant:  :pill | :underline       (default :pill)
    active:   id of the initially active tab   (default first)
    name:     String — value broadcast on tabs:change (default "tab")
  --------------------------------------------------------------------------
  Example:
    <%= render "shared/tabs", variant: :pill, tabs: [
          { id: "weapon", label: "Weapon" }, { id: "force", label: "Force" } ] %>
%>
<% variant ||= :pill
   active  ||= tabs.first[:id]
   name    ||= "tab" %>

<% if variant == :underline %>
  <div class="flex w-full gap-1"
       data-controller="tabs" data-tabs-active-class="on"
       data-tabs-name-value="<%= name %>">
    <% tabs.each do |t| %>
      <button type="button"
              data-tabs-target="tab" data-tab-id="<%= t[:id] %>"
              data-action="tabs#select"
              class="relative flex flex-1 min-w-0 min-h-tap items-center justify-center
                     text-[13px] font-semibold text-text-mute hover:text-text-dim
                     [&.on]:text-text
                     after:content-[''] after:absolute after:left-1/2 after:-translate-x-1/2
                     after:bottom-2 after:h-0.5 after:w-3/5 after:max-w-16 after:rounded-px
                     after:bg-brass after:opacity-0 [&.on]:after:opacity-100
                     <%= 'on' if t[:id] == active %>">
        <%= t[:label] %>
      </button>
    <% end %>
  </div>
<% else %>
  <div class="flex gap-1 rounded-field bg-card-hi p-1"
       data-controller="tabs" data-tabs-active-class="on"
       data-tabs-name-value="<%= name %>">
    <% tabs.each do |t| %>
      <button type="button"
              data-tabs-target="tab" data-tab-id="<%= t[:id] %>"
              data-action="tabs#select"
              class="flex flex-1 min-h-tap items-center justify-center rounded-[7px]
                     text-[13px] font-bold text-text-dim
                     [&.on]:bg-bg [&.on]:text-text [&.on]:shadow-[0_1px_2px_rgba(0,0,0,0.4)]
                     <%= 'on' if t[:id] == active %>">
        <%= t[:label] %>
      </button>
    <% end %>
  </div>
<% end %>
