<%#
  HOTWIRE PATTERN — lazy-loaded editor in a Turbo Frame modal
  ===========================================================================
  The home "Skills" card shows read-only levels. "Edit Planned" pops the editor
  in a modal WITHOUT a full navigation: a permanent <turbo-frame id="modal">
  lives in the layout; the link targets it; the controller responds with the
  modal partial; the dialog controller calls showModal() on frame load.
  ===========================================================================
%>

<%# 1. In app/views/layouts/application.html.erb — one persistent frame: %>
<%#   <turbo-frame id="modal"></turbo-frame>                                 %>

<%# 2. The trigger on the home card. data-turbo-frame sends the response into  %>
<%#    the #modal frame instead of replacing the page.                        %>
<%= link_to "Edit Planned",
      edit_character_plan_path(@character, kind: "future"),
      data: { turbo_frame: "modal" },
      class: "btn-primary flex-1" %>

<%# 3. PlansController#edit renders ONLY the frame (layout: false is implied   %>
<%#    when the request targets a frame). app/views/plans/edit.html.erb:       %>
<turbo-frame id="modal">
  <%= render "shared/modal", title: "Edit — Planned", size: :lg do %>
    <%# the skill editor body: char_bar + tabs + series of skill_row partials %>
    <%= render "shared/char_bar", name: @character.name, race: @character.race, level_cap: @character.level_cap %>
    <%= render "shared/tabs", variant: :pill, tabs: @groups %>
    <div class="mt-3.5 overflow-hidden rounded-tab bg-card-hi">
      <%= render partial: "shared/skill_row", collection: @skills, as: :skill %>
    </div>
  <% end %>
</turbo-frame>

<%#  4. Auto-open: the dialog controller's connect() calls showModal(); when the
     user closes, redirect/clear the frame so it can re-open later:
       Turbo.visit(location.href, { frame: "modal" })  — or render an empty frame.
%>
