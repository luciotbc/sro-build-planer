<%#
  shared/stat_row — "current (+delta) = planned" line
  The signature pattern of the app: a white current value, green delta, brass total.
  --------------------------------------------------------------------------
  locals:
    label:    String
    current:  Numeric
    planned:  Numeric
    format:   :int | :comma     (default :int)
  --------------------------------------------------------------------------
  Wrap several in a divided card:
    <div class="overflow-hidden rounded-control bg-card-hi border border-line">
      <%= render "shared/stat_row", label: "Skill points",  current: 3_210_000, planned: 6_440_000, format: :comma %>
      <%= render "shared/stat_row", label: "Mastery total", current: 210,       planned: 440 %>
    </div>
%>
<% fmt   = ->(n) { local_assigns[:format] == :comma ? number_with_delimiter(n) : n }
   delta = planned - current %>
<div class="flex flex-wrap items-baseline gap-x-3 gap-y-2.5 border-t border-line px-3.5 py-3.5 first:border-t-0">
  <span class="text-sm font-bold uppercase tracking-[0.6px] text-text-dim"><%= label %></span>
  <span class="ml-auto inline-flex items-baseline gap-2 tnum">
    <span class="font-bold text-white"><%= fmt.(current) %></span>
    <% if delta != 0 %>
      <span class="text-text-mute font-bold"><%= delta.positive? ? "+" : "−" %></span>
      <span class="text-[11px] font-bold <%= delta.positive? ? 'text-green' : 'text-red' %>"><%= fmt.(delta.abs) %></span>
    <% end %>
    <span class="text-text-mute font-bold">=</span>
    <span class="font-extrabold text-brass-hi"><%= fmt.(planned) %></span>
  </span>
</div>
